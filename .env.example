# Vortex Web → Vortex Core

# Local / Vite proxy defaults
VITE_API_URL=/api/v1
VITE_WS_URL=
VITE_USE_MSW=false

# Agent install (Hosts → Install agent)
VITE_AGENT_CORE_URL=ws://127.0.0.1:8000
# Absolute base for vortex-agent-linux-{amd64,arm64}. Required in production builds.
# Dev without env: Vite serves ../VortexAgent via `make publish-web` at /agent.
# VITE_AGENT_BINARY_BASE_URL=https://cdn.example.com/agent

# Production (see .env.production.example / Docker build args):
# VITE_API_URL=https://api.vortex.timant32.ru/api/v1
# VITE_WS_URL=wss://api.vortex.timant32.ru/ws
# VITE_AGENT_CORE_URL=wss://api.vortex.timant32.ru
# VITE_AGENT_BINARY_BASE_URL=https://github.com/vortexssh/vortex-agent/releases/download/v0.1.0
