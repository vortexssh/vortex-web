# Production build-time vars (passed as Docker build args)
VITE_API_URL=https://api.vortex.timant32.ru/api/v1
VITE_WS_URL=wss://api.vortex.timant32.ru/ws
VITE_AGENT_CORE_URL=wss://api.vortex.timant32.ru
# Optional override for agent binary CDN. Empty = auto: <web-origin>/agent
# (binaries are baked into the Web Docker image from VortexAgent).
VITE_AGENT_BINARY_BASE_URL=
VITE_USE_MSW=false
